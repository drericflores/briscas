#!/bin/sh
set -eu
log_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/briscas"
mkdir -p "$log_dir"
if ! /usr/bin/python3 -m briscas "$@" 2>>"$log_dir/briscas.log"; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Briscas" --text="Briscas could not start. Diagnostic log: $log_dir/briscas.log"
    fi
    exit 1
fi
